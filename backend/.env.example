# Environment configuration template
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/vericampus

# Security & JWT Settings (NOTE: Replace JWT_SECRET_KEY with a random secret key locally / in production)
JWT_SECRET_KEY=replace-with-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Future CORS settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
